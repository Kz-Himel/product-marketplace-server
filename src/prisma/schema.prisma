generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]
  orders  Order[]

  @@index([email])
  @@index([isDeleted])
  @@map("users")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  description String?
  status      CategoryStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products Product[]

  @@index([isDeleted])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String
  price       Float
  stock       Int
  image       String?
  status      ProductStatus @default(ACTIVE)
  categoryId  String
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  reviews  Review[]
  orders   Order[]

  @@index([categoryId])
  @@index([isDeleted])
  @@map("products")
}

model Review {
  id        String       @id @default(uuid())
  rating    Int
  comment   String
  status    ReviewStatus @default(PUBLISHED)
  userId    String
  productId String
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([isDeleted])
  @@map("reviews")
}

model Order {
  id         String      @id @default(uuid())
  quantity   Int
  totalPrice Float
  status     OrderStatus @default(PENDING)
  userId     String
  productId  String
  isDeleted  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([isDeleted])
  @@map("orders")
}